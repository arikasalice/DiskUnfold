<?xml version="1.0" encoding="utf-8"?>
<!--
  DiskUnfold Windows Installer package (F15 FR9.HD1, install form msi).

  Per-user install under %LOCALAPPDATA%\Programs\DiskUnfold. No elevation, no UI extension and no
  WiX extension, so building it needs only wix.exe. The package installs diskunfold.exe, LICENSE,
  THIRD-PARTY-NOTICES.txt and the one-line install-form marker, and adds the install folder to the
  user PATH (the msi CLI entry path, FR9.HD1). Uninstall removes those and leaves the user's data
  folder alone.

  The package does not carry the Microsoft Edge WebView2 Runtime. Windows 11 ships it; when it is
  missing, the application stops before its window and points the user to Microsoft's public
  WebView2 page. Variables, all passed by package-windows-msi.ps1: Version, ExePath, LicensePath,
  NoticesPath, InstallFormPath, IconPath.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DiskUnfold" Manufacturer="DiskUnfold" Version="$(Version)"
           UpgradeCode="6f3a7b1e-2c1d-4a8e-9b53-5d0c8e41f7a2" Scope="perUser"
           Language="1033" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="DiskUnfold installer" Manufacturer="DiskUnfold" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of DiskUnfold is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DiskUnfoldIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DiskUnfoldIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arikasalice/DiskUnfold" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DiskUnfold" />
      </Directory>
    </StandardDirectory>

    <!-- A per-user component needs an HKCU key path (ICE38), so the files hang off this value. -->
    <Component Id="ProductComponent" Directory="INSTALLFOLDER" Guid="3d1f0c52-8a47-4b6e-a0c9-7e2b9d64c815">
      <RegistryValue Root="HKCU" Key="Software\DiskUnfold\Installer" Name="InstallFolder"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <File Id="DiskUnfoldExe" Name="diskunfold.exe" Source="$(ExePath)" />
      <File Id="LicenseFile" Name="LICENSE" Source="$(LicensePath)" />
      <File Id="NoticesFile" Name="THIRD-PARTY-NOTICES.txt" Source="$(NoticesPath)" />
      <File Id="InstallFormFile" Name="install-form" Source="$(InstallFormPath)" />
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Feature Id="Main" Title="DiskUnfold" Level="1">
      <ComponentRef Id="ProductComponent" />
    </Feature>
  </Package>
</Wix>
